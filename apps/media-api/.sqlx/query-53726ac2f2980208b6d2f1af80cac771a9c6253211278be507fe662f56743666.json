  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                original_url,\n                slug,\n                created_at,\n                expires_at,\n                COALESCE((\n                    SELECT COUNT(*)\n                    FROM clicks\n                    WHERE clicks.link_id = links.id\n                ), 0)::INT AS \"clicks!\"\n            FROM links\n            WHERE slug = $1\n            ",
